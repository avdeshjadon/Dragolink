SPRING_DATASOURCE_URL=jdbc:mysql://your_db_host:3306/dragolink?useSSL=true&requireSSL=true&createDatabaseIfNotExist=true
SPRING_DATASOURCE_USERNAME=your_db_user
SPRING_DATASOURCE_PASSWORD=your_db_password
REDIS_URL=rediss://default:your_upstash_redis_password@your_upstash_redis_endpoint:6379
SPRING_KAFKA_BOOTSTRAP_SERVERS=your_kafka_servers:25267
SPRING_KAFKA_SECURITY_PROTOCOL=SASL_SSL
SPRING_KAFKA_SASL_MECHANISM=PLAIN
SPRING_KAFKA_SASL_JAAS_CONFIG=org.apache.kafka.common.security.plain.PlainLoginModule required username="your_kafka_user" password="your_kafka_password";
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:5174,https://dragolink.vercel.app
APP_BASE_URL=https://dragolink.duckdns.org/
APP_JWT_SECRET=your_jwt_secret_key_here
APP_JWT_EXPIRATIONMS=86400000

# Email / SMTP Configuration
SPRING_MAIL_USERNAME=your_email@gmail.com
SPRING_MAIL_PASSWORD="your_google_app_password"

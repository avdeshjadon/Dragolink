# MySQL Database
MYSQL_DATABASE=dragolink
MYSQL_ROOT_PASSWORD=your_root_password
MYSQL_USER=root
MYSQL_PASSWORD=root

# Backend Configuration (Spring Boot)
SPRING_DATASOURCE_URL=jdbc:mysql://mysql:3306/dragolink?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=your_db_user
SPRING_DATASOURCE_PASSWORD=your_db_password
REDIS_URL=rediss://default:your_upstash_redis_password@your_upstash_redis_endpoint:6379
SPRING_KAFKA_BOOTSTRAP_SERVERS=kafka:29092

# JWT Authentication (Use a strong 256-bit Hex or Base64 secret)
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long
JWT_EXPIRATION_MS=86400000

# Application Base URL
APP_BASE_URL=http://localhost:8080/

# Frontend Configuration (Vite uses VITE_ prefix)
VITE_API_BASE_URL=http://localhost:8080/api
